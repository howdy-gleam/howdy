//// The SQL behind howdy/jobs, for PostgreSQL and SQLite.
////
//// Gloo binds SQLite parameters by rewriting `$N` to `?` in order, so every
//// statement here uses each placeholder once, numbered in the order they
//// appear, and at most nine of them. Job and queue names are checked to be
//// plain words before they get here, so where a statement needs more
//// values than that, they and trusted integers are written inline.

import gleam/dynamic/decode
import gleam/int
import gleam/list
import gleam/option.{type Option, None, Some}
import gleam/order
import gleam/result
import gleam/string
import gloo/repo.{type Repo}
import gloo/sql
import gloo/value.{type GlooValue}
import howdy/database.{Postgres, Sqlite}
import howdy/service

pub const table = "howdy_jobs"

/// A row of `howdy_jobs`. Times are unix milliseconds.
pub type Row {
  Row(
    id: Int,
    name: String,
    queue: String,
    args: String,
    state: String,
    priority: Int,
    attempt: Int,
    max_attempts: Int,
    scheduled_at: Int,
    inserted_at: Int,
    attempted_at: Option(Int),
    finished_at: Option(Int),
    attempted_by: Option(String),
    unique_key: Option(String),
    errors: String,
    traceparent: Option(String),
  )
}

const columns = "id, name, queue, args, state, priority, attempt, max_attempts, scheduled_at, inserted_at, attempted_at, finished_at, attempted_by, unique_key, errors, traceparent"

fn row_decoder() -> decode.Decoder(Row) {
  use id <- decode.field(0, decode.int)
  use name <- decode.field(1, decode.string)
  use queue <- decode.field(2, decode.string)
  use args <- decode.field(3, decode.string)
  use state <- decode.field(4, decode.string)
  use priority <- decode.field(5, decode.int)
  use attempt <- decode.field(6, decode.int)
  use max_attempts <- decode.field(7, decode.int)
  use scheduled_at <- decode.field(8, decode.int)
  use inserted_at <- decode.field(9, decode.int)
  use attempted_at <- decode.field(10, decode.optional(decode.int))
  use finished_at <- decode.field(11, decode.optional(decode.int))
  use attempted_by <- decode.field(12, decode.optional(decode.string))
  use unique_key <- decode.field(13, decode.optional(decode.string))
  use errors <- decode.field(14, decode.string)
  use traceparent <- decode.field(15, decode.optional(decode.string))
  decode.success(Row(
    id:,
    name:,
    queue:,
    args:,
    state:,
    priority:,
    attempt:,
    max_attempts:,
    scheduled_at:,
    inserted_at:,
    attempted_at:,
    finished_at:,
    attempted_by:,
    unique_key:,
    errors:,
    traceparent:,
  ))
}

/// The states a job not yet finished can be in. A unique key is only
/// unique among these.
const unfinished = "('available', 'executing')"

pub fn migrations() -> String {
  "CREATE TABLE howdy_jobs_queues (
     queue TEXT PRIMARY KEY,
     paused INTEGER NOT NULL,
     changed_at BIGINT NOT NULL
   );
   CREATE TABLE howdy_jobs_schedules (
     name TEXT PRIMARY KEY,
     last_at BIGINT NOT NULL,
     queued_at BIGINT
   );" <> "\n-- howdy:postgres\n" <> jobs_table(
    "id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY",
  ) <> "\n-- howdy:sqlite\n" <> jobs_table(
    "id INTEGER PRIMARY KEY AUTOINCREMENT",
  )
}

fn jobs_table(id: String) -> String {
  "CREATE TABLE howdy_jobs (
     " <> id <> ",
     name TEXT NOT NULL,
     queue TEXT NOT NULL,
     args TEXT NOT NULL,
     state TEXT NOT NULL,
     priority INTEGER NOT NULL,
     attempt INTEGER NOT NULL,
     max_attempts INTEGER NOT NULL,
     scheduled_at BIGINT NOT NULL,
     inserted_at BIGINT NOT NULL,
     attempted_at BIGINT,
     finished_at BIGINT,
     lease_until BIGINT,
     attempted_by TEXT,
     unique_key TEXT,
     unique_waiting INTEGER NOT NULL DEFAULT 0,
     errors TEXT NOT NULL,
     traceparent TEXT
   );
   CREATE INDEX howdy_jobs_available
     ON howdy_jobs (queue, priority, scheduled_at, id)
     WHERE state = 'available';
   CREATE INDEX howdy_jobs_executing
     ON howdy_jobs (lease_until) WHERE state = 'executing';
   CREATE INDEX howdy_jobs_finished
     ON howdy_jobs (finished_at) WHERE finished_at IS NOT NULL;
   CREATE INDEX howdy_jobs_by_state ON howdy_jobs (state, id);
   CREATE UNIQUE INDEX howdy_jobs_unique ON howdy_jobs (unique_key)
     WHERE unique_key IS NOT NULL AND unique_waiting = 0
       AND state IN " <> unfinished <> ";
   CREATE UNIQUE INDEX howdy_jobs_unique_waiting ON howdy_jobs (unique_key)
     WHERE unique_key IS NOT NULL AND unique_waiting = 1
       AND state = 'available'"
}

/// A name written into SQL. Names are checked before they get here; the
/// quotes are doubled all the same.
pub fn literal(text: String) -> String {
  "'" <> string.replace(text, "'", "''") <> "'"
}

fn literals(texts: List(String)) -> String {
  "(" <> list.map(texts, literal) |> string.join(", ") <> ")"
}

fn ids(ids: List(Int)) -> String {
  "(" <> list.map(ids, int.to_string) |> string.join(", ") <> ")"
}

/// Run an UPDATE or DELETE on `howdy_jobs` and say how many rows it
/// changed. Gloo's SQLite adapter counts only the rows a statement returns,
/// so the statement returns them.
fn affected(
  conn: Repo,
  statement: String,
  args: List(GlooValue),
) -> service.Result(Int) {
  database.query(
    conn,
    statement <> " RETURNING id",
    args,
    decode.field(0, decode.int, decode.success),
  )
  |> result.map(list.length)
}

// -- Inserting -----------------------------------------------------------------

pub type New {
  New(
    name: String,
    queue: String,
    args: String,
    priority: Int,
    max_attempts: Int,
    scheduled_at: Int,
    inserted_at: Int,
    unique_key: Option(String),
    /// The key only counts while the job waits to start.
    unique_waiting: Bool,
    traceparent: Option(String),
  )
}

/// Insert a job and give its id, and whether it is new: with a unique key
/// already held, the holder's id instead.
pub fn insert(conn: Repo, job: New) -> service.Result(#(Int, Bool)) {
  use conn <- database.connect(conn)
  use rows <- result.try(database.query(
    conn,
    "INSERT INTO howdy_jobs (name, queue, args, state, priority, attempt,
       max_attempts, scheduled_at, inserted_at, unique_key, unique_waiting,
       errors, traceparent)
     VALUES ($1, $2, $3, 'available', " <> int.to_string(job.priority) <> ", 0, " <> int.to_string(
      job.max_attempts,
    ) <> ", $4, $5, $6, " <> flag(job.unique_waiting) <> ", '[]', $7)
     ON CONFLICT DO NOTHING RETURNING id",
    [
      sql.string(job.name),
      sql.string(job.queue),
      sql.string(job.args),
      sql.int(job.scheduled_at),
      sql.int(job.inserted_at),
      sql.nullable(sql.string, job.unique_key),
      sql.nullable(sql.string, job.traceparent),
    ],
    decode.field(0, decode.int, decode.success),
  ))
  case rows, job.unique_key {
    [id, ..], _ -> Ok(#(id, True))
    [], Some(key) ->
      database.query(
        conn,
        "SELECT id FROM howdy_jobs WHERE unique_key = $1 AND "
          <> case job.unique_waiting {
          True -> "unique_waiting = 1 AND state = 'available'"
          False -> "unique_waiting = 0 AND state IN " <> unfinished
        },
        [sql.string(key)],
        decode.field(0, decode.int, decode.success),
      )
      |> result.try(fn(found) {
        case found {
          [id, ..] -> Ok(#(id, False))
          // The holder finished between the two statements.
          [] -> insert(conn, job)
        }
      })
    [], None -> Error(service.Internal("the job was not inserted"))
  }
}

fn flag(on: Bool) -> String {
  case on {
    True -> "1"
    False -> "0"
  }
}

/// Tell listening nodes that `queue` has work, when the transaction
/// commits. Only PostgreSQL can.
pub fn notify(conn: Repo, queue: String) -> service.Result(Nil) {
  case database.backend(conn) {
    Ok(Postgres) ->
      database.execute(conn, "NOTIFY howdy_jobs, " <> literal(queue), [])
    _ -> Ok(Nil)
  }
}

// -- Running -------------------------------------------------------------------

/// Mark up to `limit` jobs of `queue` that are due as executing, highest
/// priority and earliest first, and return them. Only jobs named in
/// `names`, the ones this node can run, are taken, and none from a paused
/// queue.
pub fn claim(
  conn: Repo,
  queue queue: String,
  names names: List(String),
  limit limit: Int,
  now now: Int,
  lease_until lease_until: Int,
  node node: String,
) -> service.Result(List(Row)) {
  use backend <- result.try(database.backend(conn))
  let lock = case backend {
    Postgres -> " FOR UPDATE SKIP LOCKED"
    Sqlite -> ""
  }
  use conn <- database.connect(conn)
  use rows <- result.map(database.query(
    conn,
    "UPDATE howdy_jobs SET state = 'executing', attempt = attempt + 1,
       attempted_at = $1, lease_until = $2, attempted_by = $3
     WHERE id IN (
       SELECT id FROM howdy_jobs
       WHERE state = 'available' AND queue = $4 AND scheduled_at <= $5
         AND name IN " <> literals(names) <> "
         AND NOT EXISTS (SELECT 1 FROM howdy_jobs_queues
           WHERE howdy_jobs_queues.queue = " <> literal(queue) <> " AND paused = 1)
       ORDER BY priority, scheduled_at, id LIMIT " <> int.to_string(limit) <> lock <> ")
     RETURNING " <> columns,
    [
      sql.int(now),
      sql.int(lease_until),
      sql.string(node),
      sql.string(queue),
      sql.int(now),
    ],
    row_decoder(),
  ))
  list.sort(rows, fn(a, b) {
    int.compare(a.priority, b.priority)
    |> order_then(int.compare(a.scheduled_at, b.scheduled_at))
    |> order_then(int.compare(a.id, b.id))
  })
}

fn order_then(first, second) {
  case first {
    order.Eq -> second
    _ -> first
  }
}

/// Where an attempt's outcome is written only while the attempt is still
/// the job's current one: a job cancelled meanwhile, or rescued from a
/// node that went quiet and claimed again, is left alone.
fn current(id: Int, attempt: Int) -> String {
  " WHERE id = "
  <> int.to_string(id)
  <> " AND attempt = "
  <> int.to_string(attempt)
  <> " AND state = 'executing'"
}

pub fn complete(
  conn: Repo,
  id: Int,
  attempt: Int,
  now: Int,
) -> service.Result(Bool) {
  use conn <- database.connect(conn)
  affected(conn, "UPDATE howdy_jobs SET state = 'completed', finished_at = $1,
       lease_until = NULL" <> current(id, attempt), [sql.int(now)])
  |> result.map(fn(n) { n > 0 })
}

/// Make the job available again at `at`, with its errors so far.
/// Put a job back to wait, unless it is unique while waiting and a newer
/// job with its key already waits: that one will do the work, so this one
/// is cancelled instead, rather than breaking the key's uniqueness.
fn wait_again(now: Int) -> String {
  let superseded =
    "(unique_waiting = 1 AND EXISTS (SELECT 1 FROM howdy_jobs newer
       WHERE newer.unique_key = howdy_jobs.unique_key
         AND newer.unique_waiting = 1 AND newer.state = 'available'
         AND newer.id <> howdy_jobs.id))"
  "state = CASE WHEN "
  <> superseded
  <> " THEN 'cancelled' ELSE 'available' END, finished_at = CASE WHEN "
  <> superseded
  <> " THEN "
  <> int.to_string(now)
  <> " ELSE NULL END"
}

pub fn reschedule(
  conn: Repo,
  id: Int,
  attempt: Int,
  at: Int,
  errors: String,
  now: Int,
) -> service.Result(Bool) {
  use conn <- database.connect(conn)
  affected(
    conn,
    "UPDATE howdy_jobs SET " <> wait_again(now) <> ", scheduled_at = $1,
       errors = $2, lease_until = NULL" <> current(id, attempt),
    [
      sql.int(at),
      sql.string(errors),
    ],
  )
  |> result.map(fn(n) { n > 0 })
}

/// Make the job available again at `at` without counting the attempt.
pub fn snooze(
  conn: Repo,
  id: Int,
  attempt: Int,
  at: Int,
  now: Int,
) -> service.Result(Bool) {
  use conn <- database.connect(conn)
  affected(
    conn,
    "UPDATE howdy_jobs SET " <> wait_again(now) <> ", scheduled_at = $1,
       attempt = attempt - 1, lease_until = NULL" <> current(id, attempt),
    [
      sql.int(at),
    ],
  )
  |> result.map(fn(n) { n > 0 })
}

/// Finish the job for good, as `failed` or `cancelled`.
pub fn finish(
  conn: Repo,
  id: Int,
  attempt: Int,
  state: String,
  now: Int,
  errors: String,
) -> service.Result(Bool) {
  use conn <- database.connect(conn)
  affected(
    conn,
    "UPDATE howdy_jobs SET state = $1, finished_at = $2, errors = $3,
       lease_until = NULL" <> current(id, attempt),
    [sql.string(state), sql.int(now), sql.string(errors)],
  )
  |> result.map(fn(n) { n > 0 })
}

/// Hand back jobs this node was running but is stopping before they
/// finished, without counting their attempts.
pub fn release(
  conn: Repo,
  jobs: List(#(Int, Int)),
  now: Int,
) -> service.Result(Nil) {
  use conn <- database.connect(conn)
  list.try_each(jobs, fn(job) {
    affected(
      conn,
      "UPDATE howdy_jobs SET " <> wait_again(now) <> ", attempt = attempt - 1,
         lease_until = NULL" <> current(job.0, job.1),
      [],
    )
  })
}

/// Push back the lease on jobs this node is still running.
pub fn extend(conn: Repo, jobs: List(Int), until: Int) -> service.Result(Nil) {
  case jobs {
    [] -> Ok(Nil)
    _ -> {
      use conn <- database.connect(conn)
      affected(conn, "UPDATE howdy_jobs SET lease_until = $1
         WHERE state = 'executing' AND id IN " <> ids(jobs), [sql.int(until)])
      |> result.replace(Nil)
    }
  }
}

/// Executing jobs whose lease ran out: the node running them stopped
/// without saying so. Locked until the transaction ends, on PostgreSQL.
pub fn expired(conn: Repo, now: Int, limit: Int) -> service.Result(List(Row)) {
  use backend <- result.try(database.backend(conn))
  let lock = case backend {
    Postgres -> " FOR UPDATE SKIP LOCKED"
    Sqlite -> ""
  }
  database.query(
    conn,
    "SELECT "
      <> columns
      <> " FROM howdy_jobs WHERE state = 'executing' AND lease_until < $1
     ORDER BY lease_until LIMIT "
      <> int.to_string(limit)
      <> lock,
    [sql.int(now)],
    row_decoder(),
  )
}

/// Delete up to `limit` jobs that finished before `before`.
pub fn prune(conn: Repo, before: Int, limit: Int) -> service.Result(Int) {
  use conn <- database.connect(conn)
  affected(conn, "DELETE FROM howdy_jobs WHERE id IN (
       SELECT id FROM howdy_jobs WHERE finished_at < $1
       ORDER BY finished_at LIMIT " <> int.to_string(limit) <> ")", [
    sql.int(before),
  ])
}

// -- Looking --------------------------------------------------------------------

pub type Filter {
  Filter(
    state: Option(String),
    scheduled: Option(Bool),
    queue: Option(String),
    name: Option(String),
    before: Option(Int),
    limit: Int,
  )
}

/// Jobs matching `filter`, newest first. `scheduled` narrows available jobs
/// to those due later (`True`) or due now (`False`), measured from `now`.
pub fn list(conn: Repo, filter: Filter, now: Int) -> service.Result(List(Row)) {
  let conditions = []
  let conditions = case filter.state {
    Some(state) -> [#("state = ", Some(sql.string(state))), ..conditions]
    None -> conditions
  }
  let conditions = case filter.scheduled {
    Some(True) -> [#("scheduled_at > ", Some(sql.int(now))), ..conditions]
    Some(False) -> [#("scheduled_at <= ", Some(sql.int(now))), ..conditions]
    None -> conditions
  }
  let conditions = case filter.queue {
    Some(queue) -> [#("queue = ", Some(sql.string(queue))), ..conditions]
    None -> conditions
  }
  let conditions = case filter.name {
    Some(name) -> [#("name = ", Some(sql.string(name))), ..conditions]
    None -> conditions
  }
  let conditions = case filter.before {
    Some(id) -> [#("id < ", Some(sql.int(id))), ..conditions]
    None -> conditions
  }
  let #(clauses, args, _) =
    list.reverse(conditions)
    |> list.fold(#([], [], 1), fn(acc, condition) {
      let #(clauses, args, n) = acc
      case condition {
        #(clause, Some(arg)) -> #(
          [clause <> "$" <> int.to_string(n), ..clauses],
          [arg, ..args],
          n + 1,
        )
        #(clause, None) -> #([clause, ..clauses], args, n)
      }
    })
  let where = case clauses {
    [] -> ""
    _ -> " WHERE " <> string.join(list.reverse(clauses), " AND ")
  }
  use conn <- database.connect(conn)
  database.query(
    conn,
    "SELECT "
      <> columns
      <> " FROM howdy_jobs"
      <> where
      <> " ORDER BY id DESC LIMIT "
      <> int.to_string(filter.limit),
    list.reverse(args),
    row_decoder(),
  )
}

pub fn get(conn: Repo, id: Int) -> service.Result(Row) {
  use conn <- database.connect(conn)
  database.one(
    conn,
    "SELECT " <> columns <> " FROM howdy_jobs WHERE id = $1",
    [sql.int(id)],
    row_decoder(),
    or: service.NotFound("no job has that id"),
  )
}

/// How many jobs each queue has in each state, with available jobs that
/// are due later counted as `scheduled`.
pub fn counts(
  conn: Repo,
  now: Int,
) -> service.Result(List(#(String, String, Int))) {
  use conn <- database.connect(conn)
  database.query(
    conn,
    "SELECT queue, CASE WHEN state = 'available' AND scheduled_at > $1
       THEN 'scheduled' ELSE state END AS shown, COUNT(*)
     FROM howdy_jobs GROUP BY queue, shown ORDER BY queue, shown",
    [sql.int(now)],
    {
      use queue <- decode.field(0, decode.string)
      use state <- decode.field(1, decode.string)
      use count <- decode.field(2, decode.int)
      decode.success(#(queue, state, count))
    },
  )
}

pub fn names(conn: Repo) -> service.Result(List(String)) {
  use conn <- database.connect(conn)
  database.query(
    conn,
    "SELECT DISTINCT name FROM howdy_jobs ORDER BY name",
    [],
    decode.field(0, decode.string, decode.success),
  )
}

// -- Changing by hand -------------------------------------------------------------

/// Run a job that is waiting, failed or was cancelled as soon as possible,
/// allowing it one more attempt if it has used them all. A job whose
/// unique key another unfinished job holds is left alone.
pub fn retry(conn: Repo, id: Int, now: Int) -> service.Result(Bool) {
  use conn <- database.connect(conn)
  affected(
    conn,
    "UPDATE howdy_jobs SET state = 'available', scheduled_at = $1,
       finished_at = NULL,
       max_attempts = CASE WHEN attempt >= max_attempts
         THEN attempt + 1 ELSE max_attempts END
     WHERE id = $2 AND state IN ('available', 'failed', 'cancelled')
       AND (state = 'available' OR unique_key IS NULL OR NOT EXISTS (
         SELECT 1 FROM howdy_jobs holder
         WHERE holder.unique_key = howdy_jobs.unique_key
           AND holder.unique_waiting = howdy_jobs.unique_waiting
           AND holder.state IN ('available', 'executing')
           AND holder.id <> howdy_jobs.id))",
    [sql.int(now), sql.int(id)],
  )
  |> result.map(fn(n) { n > 0 })
}

/// Cancel a job that has not finished. One that is running carries on, but
/// what it returns is ignored.
pub fn cancel(conn: Repo, id: Int, now: Int) -> service.Result(Bool) {
  use conn <- database.connect(conn)
  affected(conn, "UPDATE howdy_jobs SET state = 'cancelled', finished_at = $1,
       lease_until = NULL
     WHERE id = $2 AND state IN " <> unfinished, [sql.int(now), sql.int(id)])
  |> result.map(fn(n) { n > 0 })
}

/// Delete a job that is not running.
pub fn delete(conn: Repo, id: Int) -> service.Result(Bool) {
  use conn <- database.connect(conn)
  affected(
    conn,
    "DELETE FROM howdy_jobs WHERE id = $1 AND state <> 'executing'",
    [sql.int(id)],
  )
  |> result.map(fn(n) { n > 0 })
}

pub fn set_paused(
  conn: Repo,
  queue: String,
  paused: Bool,
  now: Int,
) -> service.Result(Nil) {
  let paused = case paused {
    True -> 1
    False -> 0
  }
  use conn <- database.connect(conn)
  database.execute(
    conn,
    "INSERT INTO howdy_jobs_queues (queue, paused, changed_at)
     VALUES ($1, " <> int.to_string(paused) <> ", $2)
     ON CONFLICT (queue) DO UPDATE SET paused = " <> int.to_string(paused) <> ", changed_at = excluded.changed_at",
    [sql.string(queue), sql.int(now)],
  )
}

pub fn paused(conn: Repo) -> service.Result(List(String)) {
  use conn <- database.connect(conn)
  database.query(
    conn,
    "SELECT queue FROM howdy_jobs_queues WHERE paused = 1 ORDER BY queue",
    [],
    decode.field(0, decode.string, decode.success),
  )
}

// -- Schedules ----------------------------------------------------------------------

/// The last slot a schedule was queued for, creating its row as of `now`
/// if it has none, and locking it until the transaction ends.
pub fn schedule_last(conn: Repo, key: String, now: Int) -> service.Result(Int) {
  use _ <- result.try(
    database.execute(
      conn,
      "INSERT INTO howdy_jobs_schedules (name, last_at) VALUES ($1, $2)
     ON CONFLICT (name) DO NOTHING",
      [sql.string(key), sql.int(now)],
    ),
  )
  use backend <- result.try(database.backend(conn))
  let lock = case backend {
    Postgres -> " FOR UPDATE"
    Sqlite -> ""
  }
  database.one(
    conn,
    "SELECT last_at FROM howdy_jobs_schedules WHERE name = $1" <> lock,
    [sql.string(key)],
    decode.field(0, decode.int, decode.success),
    or: service.Internal("the schedule's row is missing"),
  )
}

/// Record that the schedule's `slot` was queued, at `now`.
pub fn schedule_ran(
  conn: Repo,
  key: String,
  slot: Int,
  now: Int,
) -> service.Result(Nil) {
  database.execute(
    conn,
    "UPDATE howdy_jobs_schedules SET last_at = $1, queued_at = $2
     WHERE name = $3",
    [sql.int(slot), sql.int(now), sql.string(key)],
  )
}

/// Each schedule's key, the slot it is counted from, and the last slot it
/// queued a job for, if any.
pub fn schedules(
  conn: Repo,
) -> service.Result(List(#(String, #(Int, Option(Int))))) {
  use conn <- database.connect(conn)
  database.query(
    conn,
    "SELECT name, last_at, queued_at FROM howdy_jobs_schedules ORDER BY name",
    [],
    {
      use key <- decode.field(0, decode.string)
      use last <- decode.field(1, decode.int)
      use queued <- decode.field(2, decode.optional(decode.int))
      decode.success(#(key, #(last, queued)))
    },
  )
}
