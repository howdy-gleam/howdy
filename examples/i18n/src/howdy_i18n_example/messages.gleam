//// Messages from locales, generated by howdy_i18n. Do not edit:
//// change the catalogues and run `gleam run -m howdy/i18n/cli gen`.

import gleam/time/calendar
import howdy/i18n.{type Translator}
import howdy/i18n/format
import howdy/i18n/plural

/// The locales with catalogues.
pub const locales = ["ar", "de", "en", "fr"]

/// The locale every message is written in first.
pub const source = "en"

/// cart: {count, plural, =0 {Your basket is empty.} one {You have # item in your basket.} other {You have # items in your basket.}}
pub fn cart(translator: Translator, count count: Int) -> String {
  case i18n.pick(translator, ["ar", "de", "fr", "en"]) {
    "ar" ->
      case count {
        0 -> "سلتك فارغة."
        _ ->
          case plural.cardinal("ar", count) {
            plural.Zero -> "سلتك فارغة."
            plural.One -> "في سلتك عنصر واحد."
            plural.Two -> "في سلتك عنصران."
            plural.Few ->
              "في سلتك " <> format.integer(translator, count) <> " عناصر."
            plural.Many ->
              "في سلتك " <> format.integer(translator, count) <> " عنصرًا."
            _ -> "في سلتك " <> format.integer(translator, count) <> " عنصر."
          }
      }
    "de" ->
      case count {
        0 -> "Ihr Warenkorb ist leer."
        _ ->
          case plural.cardinal("de", count) {
            plural.One ->
              "Sie haben "
              <> format.integer(translator, count)
              <> " Artikel im Warenkorb."
            _ ->
              "Sie haben "
              <> format.integer(translator, count)
              <> " Artikel im Warenkorb."
          }
      }
    "fr" ->
      case count {
        0 -> "Votre panier est vide."
        _ ->
          case plural.cardinal("fr", count) {
            plural.One ->
              "Vous avez "
              <> format.integer(translator, count)
              <> " article dans votre panier."
            plural.Many ->
              "Vous avez "
              <> format.integer(translator, count)
              <> " d’articles dans votre panier."
            _ ->
              "Vous avez "
              <> format.integer(translator, count)
              <> " articles dans votre panier."
          }
      }
    _ ->
      case count {
        0 -> "Your basket is empty."
        _ ->
          case plural.cardinal("en", count) {
            plural.One ->
              "You have "
              <> format.integer(translator, count)
              <> " item in your basket."
            _ ->
              "You have "
              <> format.integer(translator, count)
              <> " items in your basket."
          }
      }
  }
}

