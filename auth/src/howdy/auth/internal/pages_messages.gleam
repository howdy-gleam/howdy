          _ -> format.integer(translator, minutes) <> " minutos"
        }
      }
      <> "."
    "zh" ->
      "我们会通过电子邮件发送一个一次性令牌。它将在 "
      <> format.integer(translator, minutes)
      <> " 分钟后过期。"
    _ ->
      "We will email you a single-use token. It expires in "
      <> {
        case plural.cardinal("en", minutes) {
          plural.One -> format.integer(translator, minutes) <> " minute"
          _ -> format.integer(translator, minutes) <> " minutes"
        }
      }
      <> "."
  }
}

