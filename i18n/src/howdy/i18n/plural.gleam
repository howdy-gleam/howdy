              }
          }
      }
  }
}

fn cardinal_13(n: Int) -> Category {
  case n % 100 == 1 {
    True -> One
    False ->
      case n % 100 == 2 {
        True -> Two
        False ->
          case { n % 100 >= 3 && n % 100 <= 4 } {
            True -> Few
            False -> Other
