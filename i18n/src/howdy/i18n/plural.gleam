fn cardinal_0(n: Int) -> Category {
  case n == 1 {
    True -> One
    False -> Other
  }
}

fn cardinal_1(n: Int) -> Category {
  case { n >= 0 && n <= 1 } {
    True -> One
    False -> Other
  }
}

fn cardinal_2(n: Int) -> Category {
  case n == 0 || n == 1 {
    True -> One
    False -> Other
  }
}

fn cardinal_3(n: Int) -> Category {
  case n == 0 {
    True -> Zero
    False ->
      case n == 1 {
        True -> One
        False ->
          case n == 2 {
            True -> Two
            False ->
              case { n % 100 >= 3 && n % 100 <= 10 } {
                True -> Few
                False ->
                  case { n % 100 >= 11 && n % 100 <= 99 } {
                    True -> Many
                    False -> Other
                  }
              }
          }
      }
  }
}

fn cardinal_4(n: Int) -> Category {
  case n % 10 == 1 && n % 100 != 11 {
    True -> One
    False ->
      case
        { n % 10 >= 2 && n % 10 <= 4 } && !{ n % 100 >= 12 && n % 100 <= 14 }
      {
        True -> Few
        False ->
          case
            n % 10 == 0
            || { n % 10 >= 5 && n % 10 <= 9 }
            || { n % 100 >= 11 && n % 100 <= 14 }
          {
            True -> Many
            False -> Other
          }
      }
  }
}

fn cardinal_5(n: Int) -> Category {
  case n == 0 {
    True -> Zero
    False ->
      case n == 1 {
        True -> One
        False -> Other
      }
  }
}

fn cardinal_6(_n: Int) -> Category {
  Other
}

fn cardinal_7(n: Int) -> Category {
  case n % 10 == 1 && !{ n % 100 == 11 || n % 100 == 71 || n % 100 == 91 } {
    True -> One
    False ->
      case n % 10 == 2 && !{ n % 100 == 12 || n % 100 == 72 || n % 100 == 92 } {
        True -> Two
        False ->
          case
            { { n % 10 >= 3 && n % 10 <= 4 } || n % 10 == 9 }
            && !{
              { n % 100 >= 10 && n % 100 <= 19 }
              || { n % 100 >= 70 && n % 100 <= 79 }
              || { n % 100 >= 90 && n % 100 <= 99 }
            }
          {
            True -> Few
            False ->
              case n != 0 && n % 1_000_000 == 0 {
                True -> Many
                False -> Other
              }
          }
      }
  }
}

fn cardinal_8(n: Int) -> Category {
  case n % 10 == 1 && n % 100 != 11 {
    True -> One
    False ->
      case
        { n % 10 >= 2 && n % 10 <= 4 } && !{ n % 100 >= 12 && n % 100 <= 14 }
      {
        True -> Few
        False -> Other
      }
  }
}

fn cardinal_9(n: Int) -> Category {
  case n == 1 {
    True -> One
    False ->
      case n != 0 && n % 1_000_000 == 0 {
        True -> Many
        False -> Other
      }
  }
}

fn cardinal_10(n: Int) -> Category {
  case
    { n == 1 || n == 2 || n == 3 }
    || !{ n % 10 == 4 || n % 10 == 6 || n % 10 == 9 }
  {
    True -> One
    False -> Other
  }
}

fn cardinal_11(n: Int) -> Category {
  case n == 1 {
    True -> One
    False ->
      case { n >= 2 && n <= 4 } {
        True -> Few
        False -> Other
      }
  }
}

fn cardinal_12(n: Int) -> Category {
  case n == 0 {
    True -> Zero
    False ->
      case n == 1 {
        True -> One
        False ->
          case n == 2 {
            True -> Two
            False ->
              case n == 3 {
                True -> Few
                False ->
                  case n == 6 {
                    True -> Many
                    False -> Other
