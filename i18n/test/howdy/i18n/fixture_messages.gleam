/// cart.items: {count, plural, =0 {Your cart is empty} one {# item} other {# items}}
pub fn cart_items(translator: Translator, count count: Int) -> String {
  case i18n.pick(translator, ["de", "pl", "en"]) {
    "de" ->
      case count {
        0 -> "Ihr Warenkorb ist leer"
        _ ->
          case plural.cardinal("de", count) {
            plural.One -> format.integer(translator, count) <> " Artikel"
            _ -> format.integer(translator, count) <> " Artikel"
          }
      }
    "pl" ->
      case plural.cardinal("pl", count) {
        plural.One -> format.integer(translator, count) <> " produkt"
        plural.Few -> format.integer(translator, count) <> " produkty"
        plural.Many -> format.integer(translator, count) <> " produktów"
        _ -> format.integer(translator, count) <> " produktu"
      }
    _ ->
      case count {
        0 -> "Your cart is empty"
        _ ->
          case plural.cardinal("en", count) {
            plural.One -> format.integer(translator, count) <> " item"
            _ -> format.integer(translator, count) <> " items"
          }
      }
  }
}

/// greeting: Hello, {name}!
pub fn greeting(translator: Translator, name name: String) -> String {
  case i18n.pick(translator, ["de", "en-GB", "en"]) {
    "de" -> "Hallo, " <> name <> "!"
    "en-GB" -> "Hiya, " <> name <> "!"
    _ -> "Hello, " <> name <> "!"
  }
}

/// invite: {host} invited {guests, plural, offset:1 =0 {nobody} =1 {{guest}} one {{guest} and one other} other {{guest} and # others}}
pub fn invite(
  translator: Translator,
  host host: String,
  guests guests: Int,
  guest guest: String,
) -> String {
  host
  <> " invited "
  <> {
    case guests {
      0 -> "nobody"
      1 -> guest
      _ ->
        case plural.cardinal("en", guests - 1) {
          plural.One -> guest <> " and one other"
          _ ->
            guest
            <> " and "
            <> format.integer(translator, guests - 1)
            <> " others"
        }
    }
  }
}

/// place: You came {place, selectordinal, one {#st} two {#nd} few {#rd} other {#th}}
pub fn place(translator: Translator, place place: Int) -> String {
