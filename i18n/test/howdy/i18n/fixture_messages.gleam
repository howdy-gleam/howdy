    "de" -> "Du bist " <> format.integer(translator, place) <> ". geworden"
    _ ->
      "You came "
      <> {
        case plural.ordinal("en", place) {
          plural.One -> format.integer(translator, place) <> "st"
          plural.Two -> format.integer(translator, place) <> "nd"
          plural.Few -> format.integer(translator, place) <> "rd"
          _ -> format.integer(translator, place) <> "th"
        }
      }
  }
}

