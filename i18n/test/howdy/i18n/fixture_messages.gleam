/// reply: {gender, select, female {She} male {He} other {They}} replied
pub fn reply(translator: Translator, gender gender: String) -> String {
  case i18n.pick(translator, ["de", "en"]) {
    "de" ->
      {
        case gender {
          "female" -> "Sie"
          "male" -> "Er"
          _ -> "Sie"
        }
      }
      <> " hat geantwortet"
    _ ->
      {
        case gender {
          "female" -> "She"
          "male" -> "He"
          _ -> "They"
        }
      }
      <> " replied"
  }
}

/// saved: Saved on {when, date, long} at {at, time, short}
pub fn saved(
  translator: Translator,
  when when: calendar.Date,
  at at: calendar.TimeOfDay,
) -> String {
  case i18n.pick(translator, ["de", "en"]) {
    "de" ->
      "Gespeichert am "
      <> format.date(translator, when, format.Long)
      <> " um "
      <> format.time(translator, at, format.Short)
    _ ->
      "Saved on "
      <> format.date(translator, when, format.Long)
      <> " at "
      <> format.time(translator, at, format.Short)
  }
}

