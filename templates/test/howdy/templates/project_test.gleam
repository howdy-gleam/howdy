import filepath
import gleam/list
import gleam/string
import howdy/templates/internal/project.{type Project}
import simplifile

const root = "build/project_test"

/// A fresh project, `shop`, with the templates given.
fn new_project(templates: List(#(String, String))) -> Project {
  let _ = simplifile.delete(root)
  let assert Ok(_) = simplifile.create_directory_all(root <> "/templates")
  let assert Ok(_) =
    simplifile.write(
      root <> "/gleam.toml",
      "name = \"shop\"\nversion = \"1.0.0\"\n",
    )
  write_templates(templates)
  let assert Ok(project) = project.load(root)
  project
}

fn write_templates(templates: List(#(String, String))) -> Nil {
  list.each(templates, fn(template) {
    let path = root <> "/templates/" <> template.0
    let assert Ok(_) =
      simplifile.create_directory_all(filepath.directory_name(path))
    let assert Ok(_) = simplifile.write(path, template.1)
  })
}

fn read(path: String) -> String {
  let assert Ok(text) = simplifile.read(root <> "/" <> path)
  text
}

const modules = "src/shop/templates"

pub fn generates_formatted_modules_test() {
  let project =
    new_project([
      #("home.gsx", "<p>Hi</p>"),
      #("admin/users.gsx", "---\nprops(names: List(String))\n---\n<ul />"),
    ])
  let assert Ok(generated) = project.generate_all(project, gitignore: True)
  assert generated.templates == 2
  assert generated.written
    == [
      root <> "/" <> modules <> "/admin/users.gleam",
      root <> "/" <> modules <> "/home.gleam",
    ]
  assert generated.deleted == []
  let home = read(modules <> "/home.gleam")
  assert string.starts_with(home, "// Generated from templates/home.gsx by")
  assert string.contains(home, "pub fn home() {\n")
  assert string.contains(read(modules <> "/admin/users.gleam"), "pub fn users(")
  assert read(modules <> "/.gitignore")
    == "# Generated by howdy_templates from templates/. Do not edit.\n*\n"
  // Nothing changed, so nothing is written again.
  let assert Ok(again) = project.generate_all(project, gitignore: True)
  assert again.written == []
  assert project.check(project) == Ok(2)
}

pub fn check_catches_a_stale_module_test() {
  let project = new_project([#("home.gsx", "<p>Hi</p>")])
  let assert Error(report) = project.check(project)
  assert string.contains(report, "home.gleam hasn't been generated from")
  let assert Ok(_) = project.generate_all(project, gitignore: False)
  write_templates([#("home.gsx", "<p>Hello</p>")])
  let assert Error(report) = project.check(project)
  assert string.contains(report, "home.gleam is out of date with")
  assert string.contains(report, "Run: gleam run -m howdy/templates")
  // Without the option, there's no .gitignore.
  assert simplifile.is_file(root <> "/" <> modules <> "/.gitignore")
    == Ok(False)
}

pub fn a_deleted_template_takes_its_module_test() {
  let project =
    new_project([#("home.gsx", "<p />"), #("admin/users.gsx", "<p />")])
  let assert Ok(_) = project.generate_all(project, gitignore: True)
  let assert Ok(_) = simplifile.delete(root <> "/templates/admin")
  let assert Ok(generated) = project.generate_all(project, gitignore: True)
  assert generated.deleted == [root <> "/" <> modules <> "/admin/users.gleam"]
  assert simplifile.is_directory(root <> "/" <> modules <> "/admin")
    == Ok(False)
}

pub fn problems_are_reported_and_the_module_kept_test() {
  let project = new_project([#("home.gsx", "<p>Hi</p>")])
  let assert Ok(_) = project.generate_all(project, gitignore: True)
  let before = read(modules <> "/home.gleam")
  write_templates([#("home.gsx", "<main>\n  <p>Hi\n</main>\n")])
  let assert Error(report) = project.generate_all(project, gitignore: True)
  assert string.contains(report, "error: <p> is not closed")
  assert string.contains(report, "┌─ templates/home.gsx:2:")
  assert string.contains(report, "2 │   <p>Hi")
  assert read(modules <> "/home.gleam") == before
}

pub fn a_hand_written_module_is_never_replaced_test() {
  let project = new_project([#("mine.gsx", "<p />")])
  let assert Ok(_) = simplifile.create_directory_all(root <> "/" <> modules)
  let assert Ok(_) =
    simplifile.write(
      root <> "/" <> modules <> "/mine.gleam",
      "pub fn mine() { 1 }\n",
    )
  let assert Ok(_) =
    simplifile.write(
      root <> "/" <> modules <> "/other.gleam",
      "pub fn other() { 2 }\n",
    )
  let assert Error(report) = project.generate_all(project, gitignore: True)
  assert string.contains(
    report,
    "mine.gleam wasn't generated by howdy_templates",
  )
  assert read(modules <> "/mine.gleam") == "pub fn mine() { 1 }\n"
  // A hand-written module with no template is left alone too.
  assert read(modules <> "/other.gleam") == "pub fn other() { 2 }\n"
}

pub fn a_template_in_src_is_pointed_at_templates_test() {
  let project = new_project([])
  let assert Ok(_) = simplifile.create_directory_all(root <> "/src/shop")
  let assert Ok(_) = simplifile.write(root <> "/src/shop/stray.gsx", "<p />")
  let assert Error(report) = project.generate_all(project, gitignore: True)
  assert string.contains(report, "stray.gsx is in a source directory")
  assert string.contains(report, "Templates live in " <> root <> "/templates/")
}
