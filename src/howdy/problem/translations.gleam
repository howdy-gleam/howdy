    "de" -> "muss mindestens " <> int.to_string(minimum) <> " sein"
    "es" -> "debe ser como mínimo " <> int.to_string(minimum)
    "fr" -> "doit être supérieur ou égal à " <> int.to_string(minimum)
    "it" -> "deve essere almeno " <> int.to_string(minimum)
    "ja" -> int.to_string(minimum) <> "以上にしてください"
    "nl" -> "moet minstens " <> int.to_string(minimum) <> " zijn"
    "pl" -> "musi wynosić co najmniej " <> int.to_string(minimum)
    "pt" -> "deve ser no mínimo " <> int.to_string(minimum)
    "zh" -> "不能小于 " <> int.to_string(minimum)
    _ -> "must be at least " <> int.to_string(minimum)
  }
}

fn cardinal_ar(n: Int) -> String {
  let n = int.absolute_value(n)
  case n == 0 {
    True -> "zero"
    False ->
      case n == 1 {
        True -> "one"
        False ->
          case n == 2 {
            True -> "two"
            False ->
              case { n % 100 >= 3 && n % 100 <= 10 } {
                True -> "few"
                False ->
                  case { n % 100 >= 11 && n % 100 <= 99 } {
                    True -> "many"
                    False -> "other"
                  }
              }
          }
      }
  }
}

fn cardinal_de(n: Int) -> String {
  let n = int.absolute_value(n)
  case n == 1 {
    True -> "one"
    False -> "other"
  }
}

fn cardinal_en(n: Int) -> String {
  let n = int.absolute_value(n)
  case n == 1 {
    True -> "one"
    False -> "other"
  }
}

fn cardinal_es(n: Int) -> String {
  let n = int.absolute_value(n)
  case n == 1 {
    True -> "one"
    False ->
      case n != 0 && n % 1_000_000 == 0 {
        True -> "many"
        False -> "other"
      }
  }
}

fn cardinal_fr(n: Int) -> String {
  let n = int.absolute_value(n)
  case { n == 0 || n == 1 } {
    True -> "one"
    False ->
      case n != 0 && n % 1_000_000 == 0 {
        True -> "many"
        False -> "other"
      }
  }
}

fn cardinal_it(n: Int) -> String {
  let n = int.absolute_value(n)
  case n == 1 {
    True -> "one"
    False ->
      case n != 0 && n % 1_000_000 == 0 {
        True -> "many"
        False -> "other"
      }
  }
}

fn cardinal_nl(n: Int) -> String {
  let n = int.absolute_value(n)
  case n == 1 {
    True -> "one"
    False -> "other"
  }
}

fn cardinal_pl(n: Int) -> String {
  let n = int.absolute_value(n)
  case n == 1 {
    True -> "one"
    False ->
      case
        { n % 10 >= 2 && n % 10 <= 4 } && !{ n % 100 >= 12 && n % 100 <= 14 }
      {
        True -> "few"
        False ->
          case
            { n != 1 && { n % 10 >= 0 && n % 10 <= 1 } }
            || { n % 10 >= 5 && n % 10 <= 9 }
            || { n % 100 >= 12 && n % 100 <= 14 }
          {
            True -> "many"
            False -> "other"
          }
      }
  }
}

fn cardinal_pt(n: Int) -> String {
  let n = int.absolute_value(n)
  case { n >= 0 && n <= 1 } {
    True -> "one"
    False ->
      case n != 0 && n % 1_000_000 == 0 {
        True -> "many"
        False -> "other"
      }
  }
}
