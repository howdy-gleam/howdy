pub fn a_table_without_a_primary_key_is_addressed_by_rowid_test() {
  use db <- with_database
  use <- bool.guard(on_postgres(db), Nil)
  let assert Ok(_) = repo.execute(db, "CREATE TABLE loose (a TEXT, b TEXT)", [])
  let assert Ok(_) =
    repo.execute(db, "INSERT INTO loose VALUES ('x', 'y'), ('p', 'q')", [])
  let app = app(admin.database(_, db))
  let page = get(app, "/_howdy/data/loose/row?k=2")
  assert string.contains(page, "value=\"p\"")
  let _ =
    post(app, "/_howdy/data/loose/row?k=2", [
      #("value-a", "P"),
      #("value-b", "q"),
    ])
  assert count(db, "SELECT COUNT(*) FROM loose WHERE a = 'P'") == 1
  let _ = post(app, "/_howdy/data/loose/row/delete?k=1", [])
  assert count(db, "SELECT COUNT(*) FROM loose") == 1
}

pub fn a_postgres_table_without_a_primary_key_is_addressed_by_ctid_test() {
  use db <- with_database
  use <- bool.guard(!on_postgres(db), Nil)
  let assert Ok(_) = repo.execute(db, "CREATE TABLE loose (a TEXT, b TEXT)", [])
  let assert Ok(_) =
    repo.execute(db, "INSERT INTO loose VALUES ('x', 'y'), ('p', 'q')", [])
  let assert Ok([address]) =
    repo.all(
      db,
      "SELECT ctid::text FROM loose WHERE a = 'p'",
      [],
      decode.field(0, decode.string, decode.success),
    )
  let app = app(admin.database(_, db))
  let page =
    get(app, "/_howdy/data/loose/row?k=" <> uri.percent_encode(address))
  assert string.contains(page, "value=\"p\"")
  let _ =
    post(app, "/_howdy/data/loose/row?k=" <> uri.percent_encode(address), [
      #("value-a", "P"),
      #("value-b", "q"),
    ])
  assert count(db, "SELECT COUNT(*) FROM loose WHERE a = 'P'") == 1
}

// -- Notifications -----------------------------------------------------------

pub fn postgres_announces_changes_and_sqlite_does_not_test() {
  use db <- with_database
  let assert Ok(table) = schema.table(db, "notes_notes")
  case on_postgres(db) {
    False -> {
      assert !notify.available(db, None)
      assert !notify.available(
        db,
        Some(pog.default_config(process.new_name("x"))),
      )
      assert notify.install(db, table) != Ok(Nil)
      assert notify.uninstall(db) == Ok(Nil)
      assert admin.remove_notify_triggers(db) == Ok(Nil)
      // Not on PostgreSQL, subscribing fails softly.
      let assert Error(Nil) = notify.subscribe(db, None, fn(_) { Nil })
      Nil
    }
    True -> {
      assert notify.available(db, None)
      let assert Ok(Nil) = notify.install(db, table)
      // Installing twice leaves one trigger, and the package check still
      // passes with it there.
      let assert Ok(Nil) = notify.install(db, table)
      assert count(
          db,
          "SELECT COUNT(*) FROM pg_trigger WHERE tgname = 'howdy_admin_notify'",
        )
        == 1
      assert migration.check(db, notes()) == Ok(Nil)

      // Once through the pool's own settings, found inside pgo, and once
      // through settings the app gives with `notify_via`.
      let assert Ok(url) = getenv("HOWDY_ADMIN_TEST_POSTGRES_URL")
      let assert Ok(settings) = pog.url_config(process.new_name("listen"), url)
      use settings <- list.each([None, Some(settings)])
      // Each pass ends by removing the triggers, so put them back first.
      let assert Ok(Nil) = notify.install(db, table)
      let heard = process.new_subject()
      let started = process.new_subject()
      // The listener is linked to whoever subscribes: here a process of the
      // test's own, so it can be seen to stop with it.
      let owner =
        process.spawn_unlinked(fn() {
          let assert Ok(listener) =
            notify.subscribe(db, settings, fn(name) {
              process.send(heard, name)
            })
          process.send(started, postgres.listener_pid(listener))
          process.sleep(30_000)
        })
      let assert Ok(listener) = process.receive(started, 5000)
      let gone = process.monitor(listener)
      let assert Ok(_) =
        repo.execute(db, "INSERT INTO notes_notes (title) VALUES ('hello')", [])
      assert process.receive(heard, 5000) == Ok("notes_notes")
      let assert Ok(_) =
        repo.execute(db, "UPDATE notes_notes SET stars = 2", [])
      assert process.receive(heard, 5000) == Ok("notes_notes")

      // The listener follows its owner, and the triggers can be removed
      // through the public function.
      process.kill(owner)
      let assert Ok(_) =
        process.new_selector()
        |> process.select_specific_monitor(gone, fn(down) { down })
        |> process.selector_receive(within: 5000)
      let assert Ok(_) = repo.execute(db, "DELETE FROM notes_notes", [])
      assert process.receive(heard, 500) == Error(Nil)
      let assert Ok(Nil) = admin.remove_notify_triggers(db)
      assert count(
          db,
          "SELECT COUNT(*) FROM pg_trigger WHERE tgname = 'howdy_admin_notify'",
        )
        == 0
    }
  }
}

